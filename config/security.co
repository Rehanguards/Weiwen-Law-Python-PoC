# 1. INPUT RAIL (LLM tak jaane se pehle check hoga)
define subflow self check input
  $is_safe_input = execute check_input_security_action
  if not $is_safe_input
    bot express input threat blocked
    stop

# 2. OUTPUT RAIL (User ko dikhne se pehle check hoga)
define subflow self check output
  $is_safe_output = execute check_output_security_action
  if not $is_safe_output
    bot express output threat blocked
    stop

# 3. ALERT MESSAGES
define bot express input threat blocked
  "🚨 [SPATIAL GATEWAY - INPUT BLOCKED] Harmful query intercepted before LLM execution."

define bot express output threat blocked
  "🚨 [SPATIAL GATEWAY - OUTPUT BLOCKED] Response neutralized! PII or System Prompt leak detected."